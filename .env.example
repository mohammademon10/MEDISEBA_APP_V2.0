# MediSeba Environment Variables (Example Template)
# Copy to .env.local for local development. NEVER commit actual keys to version control!

# Gemini AI (Backend only - server.ts)
GEMINI_API_KEY="your-gemini-api-key"

# Application URL
APP_URL="http://localhost:3000"

# Supabase Client Configuration (Frontend - Publishable/Anon key only!)
# DO NOT place SUPABASE_SERVICE_ROLE_KEY or database passwords here.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Optional CORS Allowed Origins (Comma-separated for server.ts)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
