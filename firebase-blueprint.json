{
  "entities": {
    "User": {
      "title": "User",
      "description": "Core authentication and role information for all users.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["patient", "doctor", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended", "pending"] },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "status"]
    },
    "DoctorProfile": {
      "title": "Doctor Profile",
      "description": "Detailed professional information for doctors.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "specialty": { "type": "string" },
        "qualification": { "type": "string" },
        "experienceYears": { "type": "integer" },
        "consultationFee": { "type": "number" },
        "bio": { "type": "string" },
        "clinicName": { "type": "string" },
        "clinicAddress": { "type": "string" },
        "phone": { "type": "string" },
        "profilePhoto": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "ratingAvg": { "type": "number" },
        "ratingCount": { "type": "integer" }
      },
      "required": ["fullName", "specialty", "qualification", "consultationFee"]
    },
    "PatientProfile": {
      "title": "Patient Profile",
      "description": "Personal health information for patients.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "dateOfBirth": { "type": "string", "format": "date" },
        "phone": { "type": "string" },
        "bloodGroup": { "type": "string", "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"] },
        "allergies": { "type": "string" },
        "chronicConditions": { "type": "string" },
        "emergencyContactName": { "type": "string" },
        "emergencyContactPhone": { "type": "string" },
        "profilePhoto": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["fullName"]
    },
    "Schedule": {
      "title": "Doctor Schedule",
      "description": "Weekly availability slots for a doctor.",
      "type": "object",
      "properties": {
        "dayOfWeek": { "type": "string", "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"] },
        "startTime": { "type": "string", "format": "time" },
        "endTime": { "type": "string", "format": "time" },
        "maxPatients": { "type": "integer" },
        "slotDuration": { "type": "integer" },
        "isActive": { "type": "boolean" }
      },
      "required": ["dayOfWeek", "startTime", "endTime"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Record of a medical consultation booking.",
      "type": "object",
      "properties": {
        "appointmentNumber": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "scheduleId": { "type": "string" },
        "appointmentDate": { "type": "string", "format": "date" },
        "timeSlotStart": { "type": "string", "format": "time" },
        "timeSlotEnd": { "type": "string", "format": "time" },
        "tokenNumber": { "type": "integer" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled", "no_show"] },
        "symptoms": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appointmentNumber", "patientId", "doctorId", "appointmentDate", "tokenNumber", "status"]
    },
    "Prescription": {
      "title": "Prescription",
      "description": "Medical prescription issued after a consultation.",
      "type": "object",
      "properties": {
        "symptoms": { "type": "string" },
        "diagnosis": { "type": "string" },
        "medicineList": { "type": "string", "description": "JSON string of medicine objects" },
        "advice": { "type": "string" },
        "followUpDate": { "type": "string", "format": "date" },
        "aiSummary": { "type": "string" }
      },
      "required": ["diagnosis", "medicineList"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Financial transaction record for an appointment.",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed", "refunded"] },
        "transactionId": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paidAt": { "type": "string", "format": "date-time" }
      },
      "required": ["amount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Core user authentication and role data."
    },
    "/doctors/{doctorId}": {
      "schema": "DoctorProfile",
      "description": "Professional profile of a doctor."
    },
    "/doctors/{doctorId}/schedules/{scheduleId}": {
      "schema": "Schedule",
      "description": "Doctor availability slots."
    },
    "/patients/{patientId}": {
      "schema": "PatientProfile",
      "description": "Personal health profile of a patient."
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Appointment bookings."
    },
    "/appointments/{appointmentId}/prescriptions/{prescriptionId}": {
      "schema": "Prescription",
      "description": "Prescription details for an appointment."
    },
    "/appointments/{appointmentId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment records for an appointment."
    }
  }
}
